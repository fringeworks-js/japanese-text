{
  "name": "@fringeworks/japanese-text",
  "version": "0.4.0",
  "private": true,
  "description": "A library some will find handy, for converting and checking Japanese text, such as kana, full-width and half-width characters, and Shift_JIS.",
  "keywords": [
    "japanese",
    "kana",
    "hiragana",
    "katakana",
    "full-width",
    "half-width",
    "shift_jis",
    "normalize"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fringeworks-js/japanese-text.git"
  },
  "license": "MIT",
  "author": "Mitsuhiro Seino",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "generateEastAsianWidth": "tsx scripts/generateEastAsianWidth.ts",
    "indexes": "tsx scripts/indexes.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "pnpm build && npm publish ./dist",
    "test": "vitest",
    "tidy": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" --config ./prettier.tidy.config.ts"
  },
  "dependencies": {
    "@fringeworks/utils": "^2.4.0"
  },
  "devDependencies": {
    "@fringeworks/dev": "^0.14.0",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@12.21.0"
}
